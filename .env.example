# Frontend Environment Variables (VITE_ prefix required for Vite)

# Clerk Authentication
# Get your keys from https://dashboard.clerk.com/last-active?path=api-keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# API Configuration
VITE_API_BASE_URL=http://localhost:3001
VITE_BACKEND_URL=http://localhost:3001

# Google Gemini AI API Key (for frontend if needed)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# DEPLOYMENT INSTRUCTIONS:
# 
# FOR RENDER.COM:
# 1. Frontend Environment Variables (in Render dashboard):
#    - VITE_CLERK_PUBLISHABLE_KEY = your_clerk_publishable_key
#    - VITE_API_BASE_URL = your_backend_url (e.g., https://codex-backend.onrender.com)
#
# 2. Backend Environment Variables (in Render dashboard):
#    - GEMINI_API_KEY = your_gemini_api_key
#    - CLERK_SECRET_KEY = your_clerk_secret_key
#    - NODE_ENV = production
#    - PORT = 10000
#    - FRONTEND_URL = your_frontend_url (e.g., https://codex-frontend.onrender.com)
#    - MONGODB_URI = your_mongodb_connection_string (optional)
#    - JWT_SECRET = auto-generated by Render
#    - RATE_LIMIT_MAX = 100
#
# FOR VERCEL:
# Add these environment variables in Vercel dashboard:
# - VITE_CLERK_PUBLISHABLE_KEY = your_clerk_publishable_key
# - VITE_API_BASE_URL = your_backend_url
# - CLERK_SECRET_KEY = your_clerk_secret_key (for backend)
# - GEMINI_API_KEY = your_gemini_api_key (for backend)