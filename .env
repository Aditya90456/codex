# Frontend Environment Variables (VITE_ prefix required for Vite)
# Get your actual Clerk publishable key from https://dashboard.clerk.com/last-active?path=api-keys
# IMPORTANT: Replace this with your REAL Clerk publishable key from the dashboard
# Your current key is INVALID - it ends with $ which breaks authentication
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZW5kbGVzcy1ibG93ZmlzaC01OS5jbGVyay5hY2NvdW50cy5kZXYk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZW5kbGVzcy1ibG93ZmlzaC01OS5jbGVyay5hY2NvdW50cy5kZXYk
VITE_API_BASE_URL=http://localhost:3001
GEMINI_API_KEY=AIzaSyDOi9jcU1DEmqMSlrCo1yvbBkal2kMM4Fg
# INSTRUCTIONS TO GET YOUR REAL CLERK KEY:
# 1. Go to https://dashboard.clerk.com
# 2. Select your application (or create one)
# 3. Go to "API Keys" in the sidebar
# 4. Copy the "Publishable key" (starts with pk_test_)
# 5. Replace the value above with your real key
# 6. Restart your development server

# FOR VERCEL DEPLOYMENT:
# Add these environment variables in Vercel dashboard:
# VITE_CLERK_PUBLISHABLE_KEY = your_real_publishable_key
# CLERK_SECRET_KEY = your_real_secret_key
# VITE_API_BASE_URL = your_backend_url