PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (if using one)
# DATABASE_URL=mongodb://localhost:27017/codex-leetcode
# POSTGRES_URL=postgresql://user:password@localhost:5432/codex

# Security
JWT_SECRET=your-super-secret-jwt-key-here
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION=60

# Code Execution
CODE_TIMEOUT=5000
MAX_CODE_LENGTH=10000